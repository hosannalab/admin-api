# PostgreSQL connection for Prisma/Nest
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spot_deportivo?schema=public"

# API auth settings
JWT_SECRET="change-this-secret"
JWT_EXPIRES_IN="1d"
PUBLIC_API_KEY="change-this-public-api-key"
PORT=3000

# Optional passwords for prisma:seed / prisma:seed-users
# If omitted, secure passwords are generated and printed once during seed.
SEED_ADMIN_PASSWORD=""
SEED_INVENTORY_PASSWORD=""
SEED_CATALOG_PASSWORD=""

# MinIO / S3-compatible storage
S3_ENDPOINT="http://127.0.0.1:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="spot-deportivo"
S3_REGION="us-east-1"
# URL pública para servir archivos (path-style MinIO)
S3_PUBLIC_URL="http://127.0.0.1:9000/spot-deportivo"
