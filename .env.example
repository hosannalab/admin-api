# PostgreSQL connection for Prisma/Nest
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spot_deportivo?schema=public"

# API auth settings
JWT_SECRET="change-this-secret"
JWT_EXPIRES_IN="1d"
PUBLIC_API_KEY="change-this-public-api-key"
PORT=3000
# URL pública de esta API (sin slash final). Las imágenes de R2 se sirven por /public/media
API_PUBLIC_URL="http://localhost:3000"

# Optional passwords for prisma:seed / prisma:seed-users
# If omitted, secure passwords are generated and printed once during seed.
SEED_ADMIN_PASSWORD=""
SEED_INVENTORY_PASSWORD=""
SEED_CATALOG_PASSWORD=""

# Cloudflare R2 (S3-compatible). Endpoint is the API, not the public URL.
# S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY="<r2-access-key-id>"
# S3_SECRET_KEY="<r2-secret-access-key>"
# S3_BUCKET="spot-deportivo"
# S3_REGION="auto"
# Custom domain or r2.dev URL bound to the bucket (no bucket name in the path)
# S3_PUBLIC_URL="https://media.tudominio.com"
# S3_FORCE_PATH_STYLE="true"

# Local MinIO fallback
S3_ENDPOINT="http://127.0.0.1:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="spot-deportivo"
S3_REGION="auto"
S3_PUBLIC_URL="http://127.0.0.1:9000/spot-deportivo"
S3_FORCE_PATH_STYLE="true"
